rules_version = '2';

// Atomid — one account, one copy of its own data.
//
// Everything an installation syncs lives under /users/{uid}/… . There is no
// sharing, no membership and no role: an account either owns the path it is
// touching or it is refused. That makes the whole policy one condition, which
// is the point — the previous store-and-membership model existed to let several
// people into one shop, and nothing needs that now.
service cloud.firestore {
  match /databases/{database}/documents {

    // The account's own subtree: products, sales, customers, suppliers,
    // purchases, expenses, inventory movements, loyalty and config.
    //
    // Matching with {document=**} rather than naming each collection is
    // deliberate. The per-collection rules that used to sit here drew their
    // distinctions from who was acting — staff may correct a sale, only the
    // owner may delete one — and with a single user there is no second party
    // for those distinctions to be about.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                            && request.auth.uid == userId;
    }

    // Anything not matched above is denied — including the old
    // /stores/{storeId}/… tree, which nothing writes to any more.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
