migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Node tooling (not part of the Flutter build)
node_modules/

# Local analysis output
flutter_analyze_output.txt

# Android release signing.
#
# The keystore is the only thing that proves an update comes from you: Play
# refuses an upload signed with a different key, and there is no recovery if it
# is lost. Committing either of these hands that ability to anyone with the
# repo, so they stay out of version control and get backed up separately.
android/key.properties
*.jks
*.keystore

# Release artifacts collected by tools/build_release.ps1.
#
# These are build outputs, not sources: every one is reproducible from a tag
# and they are large enough (APK + Windows zip + installer) to bloat the repo
# permanently, since git never forgets a blob.
/dist/
